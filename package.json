{
  "name": "pkl-viewer",
  "displayName": "PKL Viewer",
  "description": "View Python pickle (.pkl) files directly in the VS Code editor.",
  "version": "0.2.1",
  "publisher": "alarm",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaramartin/pkl-viewer.git"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "vscode",
    "extension",
    "pkl",
    "pickle",
    "python",
    "viewer"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pklViewer.pkl",
        "displayName": "PKL Viewer",
        "selector": [
          {
            "filenamePattern": "*.pkl"
          },
          {
            "filenamePattern": "*.pickle"
          },
          {
            "filenamePattern": "*.pkl.gz"
          },
          {
            "filenamePattern": "*.pkl.bz2"
          },
          {
            "filenamePattern": "*.pkl.xz"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit -p ./",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p ./",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  }
}
